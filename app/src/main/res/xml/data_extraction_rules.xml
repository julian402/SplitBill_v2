<?xml version="1.0" encoding="utf-8"?>
<!--
    Respaldo en la nube y traspaso a otro celular (Android 12 en adelante): no se copia nada.
    La sesion, los recibos y el historial de la cuenta rapida se quedan solo en este celular;
    los grupos y gastos estan en el servidor y se ven al iniciar sesion en cualquier dispositivo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
