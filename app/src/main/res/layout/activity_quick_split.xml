<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".controller.QuickSplitActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                style="@style/Widget.SplitBill.ScreenHeader"
                android:paddingStart="0dp"
                android:paddingEnd="0dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    style="@style/Widget.SplitBill.HeaderButton"
                    android:contentDescription="@string/cdBack"
                    android:src="@drawable/ic_arrow_back" />

                <LinearLayout style="@style/Widget.SplitBill.ScreenHeaderTexts">

                    <TextView
                        style="@style/Widget.SplitBill.ScreenHeaderTitle"
                        android:text="@string/tvTitleQuickSplit" />

                    <TextView
                        style="@style/Widget.SplitBill.ScreenHeaderSubtitle"
                        android:text="@string/tvQuickSubtitle" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/etSubtotal"
                        app:startIconDrawable="@drawable/ic_receipt">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSubtotal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="12" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:hint="@string/etTipPercent"
                            app:startIconDrawable="@drawable/ic_percent">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTipPercent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="3"
                                android:text="10" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:hint="@string/etPeople"
                            app:startIconDrawable="@drawable/ic_group">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPeople"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="2"
                                android:text="2" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/pbLoading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:trackCornerRadius="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Resultado que devuelve el servidor -->
            <LinearLayout
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_hero"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tvQuickPerPersonLabel"
                    android:textColor="@color/colorOnHeroSecondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvQuickPerPerson"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:textColor="@color/colorOnHero"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="38sp"
                    app:autoSizeMinTextSize="22sp"
                    app:autoSizeTextType="uniform"
                    tools:text="$ 36.667" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/Widget.SplitBill.HeroStat">

                        <TextView
                            style="@style/Widget.SplitBill.HeroStatLabel"
                            android:text="@string/tvQuickTipLabel"
                            app:drawableStartCompat="@drawable/ic_percent" />

                        <TextView
                            android:id="@+id/tvQuickTip"
                            style="@style/Widget.SplitBill.HeroStatValue"
                            tools:text="$ 10.000" />
                    </LinearLayout>

                    <LinearLayout style="@style/Widget.SplitBill.HeroStat">

                        <TextView
                            style="@style/Widget.SplitBill.HeroStatLabel"
                            android:text="@string/tvQuickTotalLabel"
                            app:drawableStartCompat="@drawable/ic_wallet" />

                        <TextView
                            android:id="@+id/tvQuickTotal"
                            style="@style/Widget.SplitBill.HeroStatValue"
                            tools:text="$ 110.000" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvQuickRemainder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="@color/colorOnHeroSecondary"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Como no da exacto, 2 persona(s) paga(n) $ 36.667"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Historial guardado con Room -->
            <LinearLayout
                style="@style/Widget.SplitBill.SectionHeader"
                android:paddingStart="4dp"
                android:paddingEnd="0dp">

                <TextView
                    style="@style/Widget.SplitBill.SectionHeaderTitle"
                    android:text="@string/tvSectionHistory" />

                <TextView
                    android:id="@+id/tvClearHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="@string/tvClearHistory"
                    android:textAppearance="@style/TextAppearance.SplitBill.Link"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEmptyHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/tvEmptyHistory"
                android:textAlignment="center"
                android:textColor="@color/colorTextSecondary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-6dp"
                android:layout_marginEnd="-6dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_history" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCalculate"
        style="@style/Widget.SplitBill.Button.Big"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/btnCalculate"
        app:icon="@drawable/ic_bolt" />
</LinearLayout>
