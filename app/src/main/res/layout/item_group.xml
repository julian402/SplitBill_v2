<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de un grupo: avatar, nombre, integrantes y total -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvGroupAvatar"
            style="@style/Widget.SplitBill.Avatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:textSize="20sp"
            tools:text="V" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGroupName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.SplitBill.ItemTitle"
                tools:text="Viaje a Cartagena" />

            <TextView
                android:id="@+id/tvGroupMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.SplitBill.ItemSubtitle"
                tools:text="3 integrantes" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvGroupTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="@style/TextAppearance.SplitBill.Amount"
            tools:text="$ 566.688" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/colorTextSecondary"
            tools:ignore="UseAppTint" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
