<?xml version="1.0" encoding="utf-8"?>
<!-- Un calculo guardado del historial: valor, propina, personas, fecha y cuanto pago cada uno -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            style="@style/Widget.SplitBill.IconCircle"
            android:contentDescription="@null"
            android:src="@drawable/ic_history"
            app:tint="@color/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHistoryDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.SplitBill.ItemTitle"
                tools:text="$ 100.000 + 10 % entre 3" />

            <TextView
                android:id="@+id/tvHistoryDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.SplitBill.ItemSubtitle"
                tools:text="2026-10-02 11:30" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHistoryPerPerson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="@style/TextAppearance.SplitBill.Amount"
            android:textColor="@color/colorPrimary"
            tools:text="$ 36.666 c/u" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
