<?xml version="1.0" encoding="utf-8"?>
<!-- Un recibo: miniatura de la foto, descripcion, fecha y valor -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivReceiptPhoto"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/colorIconCircle"
            android:contentDescription="@string/cdReceiptPhoto"
            android:padding="14dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_receipt"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.SplitBill.Rounded"
            app:tint="@color/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReceiptDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.SplitBill.ItemTitle"
                tools:text="Mercado" />

            <TextView
                android:id="@+id/tvReceiptDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.SplitBill.ItemSubtitle"
                tools:text="2026-10-02" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvReceiptAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="@style/TextAppearance.SplitBill.Amount"
            tools:text="$ 85.000" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
